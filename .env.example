# Copy to .env. Never commit .env.

# "local": passwordless demo sign-in with a private PostgreSQL created in .localdb/.
# "supabase": Supabase Auth and Postgres (required for any deployment).
AUTH_MODE=local

# Supabase mode only. Use the "Session pooler" connection string and add
# ?sslmode=require. Leave empty in local mode.
DATABASE_URL=
SUPABASE_URL=
# The publishable (anon) key. Never use the service role key; the app does not need it.
SUPABASE_ANON_KEY=
# Only if the project still signs tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# Optional. Without a key, messages are read by deterministic rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
